[Unit]
Description=核实并投递晚查寝通知

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/lzu-attendance
ExecStart=%h/.local/share/lzu-attendance/.venv/bin/python %h/.local/share/lzu-attendance/server_runner.py --flush
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/lzu-attendance
